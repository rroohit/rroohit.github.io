---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Prose from '@/components/Prose.astro';
// Mirror of the app repo's .frankie/store/PRIVACY_POLICY.md (the master copy) — also rendered
// in-app on the Privacy policy screen. Keep all three in sync when the policy changes.
import { Content as Policy } from '@/data/frankie-privacy.md';
---

<BaseLayout
  title="Frankie — Privacy Policy"
  description="Privacy policy for Frankie, the everyday-tools app: works on your device without an account, shows no ads, and only uses sign-in for optional backup and sync."
>
  <section class="container-page max-w-3xl py-14 sm:py-20">
    <Prose>
      <Policy />
    </Prose>
  </section>
</BaseLayout>