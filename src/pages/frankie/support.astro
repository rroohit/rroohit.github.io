---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Prose from '@/components/Prose.astro';
// Mirror of the app repo's .frankie/store/SUPPORT.md (the master copy). This URL is the App Store
// Connect "Support URL" — keep it live and in sync.
import { Content as Support } from '@/data/frankie-support.md';
---

<BaseLayout
  title="Frankie — Support"
  description="Help for Frankie, the everyday-tools app: contact, sync between Android and iPhone, Sign in with Apple, and deleting your account."
>
  <section class="container-page max-w-3xl py-14 sm:py-20">
    <Prose>
      <Support />
    </Prose>
  </section>
</BaseLayout>
