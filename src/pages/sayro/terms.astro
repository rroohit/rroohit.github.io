---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Prose from '@/components/Prose.astro';
// Mirror of the app repo's .sayro/legal/TERMS_OF_SERVICE.md (the master copy) — also rendered
// in-app on the Terms of Service screen. Keep all three in sync when the terms change.
import { Content as Terms } from '@/data/sayro-terms.md';
---

<BaseLayout
  title="Sayro — Terms of Service"
  description="Terms of Service for Sayro, the AI photo-styling app: acceptable use, your content, styles and coins."
>
  <section class="container-page max-w-3xl py-14 sm:py-20">
    <Prose>
      <Terms />
    </Prose>
  </section>
</BaseLayout>
